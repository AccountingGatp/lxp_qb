PORT=3000
FRONTEND_ORIGIN=http://localhost:4000
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/auth/callback
QBO_ENVIRONMENT=sandbox
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/lxp

# Backblaze B2 (S3-compatible). Required so large XLSX files bypass Vercel 413.
# Endpoint looks like https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_MAX_FILE_BYTES=52428800
